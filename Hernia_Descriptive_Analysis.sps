* Encoding: UTF-8.
FREQUENCIES VARIABLES=
Age_Code
Gender_Code
BMI_Code
ASA_Code
Treatment_Group_Clean
VAS_Code
Satisfaction_Code
Pain_Relief_Code
Adverse_Effect_Code
/ORDER=ANALYSIS.
*5.2 Age and Gender Distribution.
FREQUENCIES VARIABLES=Age_Code Gender_Code
/BARCHART FREQ
/ORDER=ANALYSIS.
CROSSTABS
/TABLES=Age_Code BY Gender_Code
/FORMAT=AVALUE TABLES
/CELLS=COUNT ROW COLUMN.
GRAPH
/BAR(GROUPED)=COUNT BY Age_Code BY Gender_Code.
*5.3 BMI and ASA Status.
FREQUENCIES VARIABLES=BMI_Code ASA_Code
/BARCHART FREQ
/ORDER=ANALYSIS.
CROSSTABS
/TABLES=BMI_Code BY ASA_Code
/FORMAT=AVALUE TABLES
/CELLS=COUNT ROW COLUMN.
GRAPH
/BAR(GROUPED)=COUNT BY BMI_Code BY ASA_Code.
*5.4 Distribution of Treatment Groups.
FREQUENCIES VARIABLES=Treatment_Group_Clean
/BARCHART FREQ
/ORDER=ANALYSIS.
FREQUENCIES VARIABLES=Treatment_Group_Clean
/PIECHART PERCENT
/ORDER=ANALYSIS.
*5.5 VAS Pain Severity.
DATASET ACTIVATE DataSet4.
FREQUENCIES VARIABLES=VAS_Code
/BARCHART FREQ
/ORDER=ANALYSIS.
FREQUENCIES VARIABLES=VAS_Code
/PIECHART PERCENT
/ORDER=ANALYSIS.
CROSSTABS
/TABLES=Treatment_Group_Clean BY VAS_Code
/FORMAT=AVALUE TABLES
/CELLS=COUNT ROW COLUMN.
GRAPH
/BAR(GROUPED)=COUNT BY VAS_Code BY Treatment_Group_Clean.
DATASET DISPLAY.
DATASET ACTIVATE DataSet4.
FREQUENCIES VARIABLES=VAS_Code.
*5.6 Patient Satisfaction.
FREQUENCIES VARIABLES=Satisfaction_Code
/BARCHART FREQ
/ORDER=ANALYSIS.
FREQUENCIES VARIABLES=Satisfaction_Code
/PIECHART PERCENT
/ORDER=ANALYSIS.
CROSSTABS
/TABLES=Treatment_Group_Clean BY Satisfaction_Code
/FORMAT=AVALUE TABLES
/CELLS=COUNT ROW COLUMN.
GRAPH
/BAR(GROUPED)=COUNT BY Satisfaction_Code BY Treatment_Group_Clean.
*5.7 Adequacy of Pain Relief.
FREQUENCIES VARIABLES=Pain_Relief_Code
/BARCHART FREQ
/ORDER=ANALYSIS.
FREQUENCIES VARIABLES=Pain_Relief_Code
/PIECHART PERCENT
/ORDER=ANALYSIS.
CROSSTABS
/TABLES=Treatment_Group_Clean BY Pain_Relief_Code
/FORMAT=AVALUE TABLES
/CELLS=COUNT ROW COLUMN.
GRAPH
/BAR(GROUPED)=COUNT BY Pain_Relief_Code BY Treatment_Group_Clean.
*5.8 Adverse Effects and Their Types.
FREQUENCIES VARIABLES=Adverse_Effect_Code
/BARCHART FREQ
/ORDER=ANALYSIS.
FREQUENCIES VARIABLES=Adverse_Effect_Code
/PIECHART PERCENT
/ORDER=ANALYSIS.
CROSSTABS
/TABLES=Treatment_Group_Clean BY Adverse_Effect_Code
/FORMAT=AVALUE TABLES
/CELLS=COUNT ROW COLUMN.
GRAPH
/BAR(GROUPED)=COUNT BY Adverse_Effect_Code BY Treatment_Group_Clean.
TEMPORARY.
SELECT IF (Adverse_Effect_Code = 1).
FREQUENCIES VARIABLES=Adverse_Effect_Clean
/ORDER=ANALYSIS.

